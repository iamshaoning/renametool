<!--
    Lucide 图标几何（https://lucide.dev，ISC 许可，v1.x）
    以下 Geometry 均为 24×24 视图坐标，描边由使用处的 Icon 样式统一提供：
    Stroke=currentColor 语义、StrokeThickness=2、圆角端点、Fill=None。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 搜索：查找替换 -->
    <PathGeometry x:Key="Icon.Search"
                  Figures="M21,21 L17.66,17.66 M3,11 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />

    <!-- 文本插入 -->
    <PathGeometry x:Key="Icon.Type"
                  Figures="M12,4 v16 M4,7 V5 a1,1 0 0 1 1,-1 h14 a1,1 0 0 1 1,1 v2 M9,20 h6" />

    <!-- 有序列表：添加序号 -->
    <PathGeometry x:Key="Icon.ListOrdered"
                  Figures="M11,5 h10 M11,12 h10 M11,19 h10 M4,4 h1 v5 M4,9 h2 M6.5,20 H3.4 c0,-1 2.6,-1.925 2.6,-3.5 a1.5,1.5 0 0 0 -2.6,-1.02" />

    <!-- 版式模板：名称模板 -->
    <PathGeometry x:Key="Icon.LayoutTemplate"
                  Figures="M4,3 h16 a1,1 0 0 1 1,1 v5 a1,1 0 0 1 -1,1 h-16 a1,1 0 0 1 -1,-1 v-5 a1,1 0 0 1 1,-1 Z M4,14 h7 a1,1 0 0 1 1,1 v5 a1,1 0 0 1 -1,1 h-7 a1,1 0 0 1 -1,-1 v-5 a1,1 0 0 1 1,-1 Z M17,14 h3 a1,1 0 0 1 1,1 v5 a1,1 0 0 1 -1,1 h-3 a1,1 0 0 1 -1,-1 v-5 a1,1 0 0 1 1,-1 Z" />

    <!-- 大小写：大小写处理 -->
    <PathGeometry x:Key="Icon.CaseSensitive"
                  Figures="M2,16 L6.039,6.31 a0.5,0.5 0 0 1 0.923,0 L11,16 M22,9 v7 M3.304,13 h6.392 M15,12.5 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0 Z" />

    <!-- 橡皮擦：删除清洗 -->
    <PathGeometry x:Key="Icon.Eraser"
                  Figures="M21,21 H8 a2,2 0 0 1 -1.42,-0.587 l-3.994,-3.999 a2,2 0 0 1 0,-2.828 l10,-10 a2,2 0 0 1 2.829,0 l5.999,6 a2,2 0 0 1 0,2.828 L12.834,21 M5.082,11.09 l8.828,8.828" />

    <!-- 日间模式 -->
    <PathGeometry x:Key="Icon.Sun"
                  Figures="M8,12 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0 Z M12,2 v2 M12,20 v2 M4.93,4.93 l1.41,1.41 M17.66,17.66 l1.41,1.41 M2,12 h2 M20,12 h2 M6.34,17.66 l-1.41,1.41 M19.07,4.93 l-1.41,1.41" />

    <!-- 夜间模式 -->
    <PathGeometry x:Key="Icon.Moon"
                  Figures="M20.985,12.486 a9,9 0 1 1 -9.473,-9.472 c0.405,-0.022 0.617,0.46 0.402,0.803 a6,6 0 0 0 8.268,8.268 c0.344,-0.215 0.825,-0.004 0.803,0.401" />

    <!-- 添加文件：导入文件 -->
    <PathGeometry x:Key="Icon.FilePlus"
                  Figures="M6,22 a2,2 0 0 1 -2,-2 V4 a2,2 0 0 1 2,-2 h8 a2.4,2.4 0 0 1 1.704,0.706 l3.588,3.588 A2.4,2.4 0 0 1 20,8 v12 a2,2 0 0 1 -2,2 z M14,2 v5 a1,1 0 0 0 1,1 h5 M9,15 h6 M12,18 v-6" />

    <!-- 添加文件夹：导入文件夹 -->
    <PathGeometry x:Key="Icon.FolderPlus"
                  Figures="M12,10 v6 M9,13 h6 M20,20 a2,2 0 0 0 2,-2 V8 a2,2 0 0 0 -2,-2 h-7.9 a2,2 0 0 1 -1.69,-0.9 L9.6,3.9 A2,2 0 0 0 7.93,3 H4 a2,2 0 0 0 -2,2 v13 a2,2 0 0 0 2,2 Z" />

    <!-- 垃圾桶：清空列表 -->
    <PathGeometry x:Key="Icon.Trash2"
                  Figures="M10,11 v6 M14,11 v6 M19,6 v14 a2,2 0 0 1 -2,2 H7 a2,2 0 0 1 -2,-2 V6 M3,6 h18 M8,6 V4 a2,2 0 0 1 2,-2 h4 a2,2 0 0 1 2,2 v2" />

    <!-- 全选 -->
    <PathGeometry x:Key="Icon.CheckSquare"
                  Figures="M21,10.656 V19 a2,2 0 0 1 -2,2 H5 a2,2 0 0 1 -2,-2 V5 a2,2 0 0 1 2,-2 h12.344 M9,11 l3,3 L22,4" />

    <!-- 全不选 -->
    <PathGeometry x:Key="Icon.Square"
                  Figures="M5,3 h14 a2,2 0 0 1 2,2 v14 a2,2 0 0 1 -2,2 h-14 a2,2 0 0 1 -2,-2 v-14 a2,2 0 0 1 2,-2 Z" />

    <!-- 撤销 -->
    <PathGeometry x:Key="Icon.RotateCcw"
                  Figures="M3,12 a9,9 0 1 0 9,-9 a9.75,9.75 0 0 0 -6.74,2.74 L3,8 M3,3 v5 h5" />

    <!-- 重做 -->
    <PathGeometry x:Key="Icon.RotateCw"
                  Figures="M21,12 a9,9 0 1 1 -9,-9 c2.52,0 4.93,1 6.74,2.74 L21,8 M21,3 v5 h-5" />

    <!-- 执行 -->
    <PathGeometry x:Key="Icon.Play"
                  Figures="M5,5 a2,2 0 0 1 3.008,-1.728 l11.997,6.998 a2,2 0 0 1 0.003,3.458 l-12,7 A2,2 0 0 1 5,19 z" />

    <!-- 钢笔线条：应用标识 -->
    <PathGeometry x:Key="Icon.PenLine"
                  Figures="M12,20 h9 M16.5,3.5 a2.12,2.12 0 0 1 3,3 L7,19 l-4,1 1,-4 Z" />

    <!-- 加号 -->
    <PathGeometry x:Key="Icon.Plus" Figures="M5,12 h14 M12,5 v14" />

    <!-- 关闭 / 删除 -->
    <PathGeometry x:Key="Icon.X" Figures="M18,6 L6,18 M6,6 L18,18" />

    <!-- 复制 -->
    <PathGeometry x:Key="Icon.Copy"
                  Figures="M10,8 h10 a2,2 0 0 1 2,2 v10 a2,2 0 0 1 -2,2 h-10 a2,2 0 0 1 -2,-2 v-10 a2,2 0 0 1 2,-2 Z M4,16 c-1.1,0 -2,-0.9 -2,-2 V4 c0,-1.1 0.9,-2 2,-2 h10 c1.1,0 2,0.9 2,2" />

    <!-- 上移 -->
    <PathGeometry x:Key="Icon.ChevronUp" Figures="M18,15 L12,9 L6,15" />

    <!-- 下移 -->
    <PathGeometry x:Key="Icon.ChevronDown" Figures="M6,9 L12,15 L18,9" />

    <!-- 窗口最小化 -->
    <PathGeometry x:Key="Icon.WindowMin" Figures="M5,12 h14" />

    <!-- 窗口最大化 -->
    <PathGeometry x:Key="Icon.WindowMax"
                  Figures="M5,3 h14 a2,2 0 0 1 2,2 v14 a2,2 0 0 1 -2,2 h-14 a2,2 0 0 1 -2,-2 v-14 a2,2 0 0 1 2,-2 Z" />

    <!-- 窗口还原（最大化状态下显示） -->
    <PathGeometry x:Key="Icon.WindowRestore"
                  Figures="M9,9 h9 a2,2 0 0 1 2,2 v9 a2,2 0 0 1 -2,2 h-9 a2,2 0 0 1 -2,-2 v-9 a2,2 0 0 1 2,-2 Z M5,17 c-1.1,0 -2,-0.9 -2,-2 V6 c0,-1.1 0.9,-2 2,-2 h9 c1.1,0 2,0.9 2,2" />

</ResourceDictionary>
