<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题：带绿相的黑（避免灰黑与墨绿不搭） -->
    <SolidColorBrush x:Key="WindowBrush" Color="#121614" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A201C" />
    <SolidColorBrush x:Key="CardBrush" Color="#1755AE80" />
    <SolidColorBrush x:Key="InputBrush" Color="#2A342E" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#232B26" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2A352E" />
    <SolidColorBrush x:Key="BorderBrush" Color="#37433B" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#4D5C53" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6EBE7" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A2ADA6" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#6C7A71" />
    <SolidColorBrush x:Key="AccentBrush" Color="#55AE80" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#67BF92" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E342A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#43C08A" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#16352A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E46A62" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3B2320" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D9A03E" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3B311D" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#55000000" />
</ResourceDictionary>
