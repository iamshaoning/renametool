<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ==================================================================
         设计令牌（Design Tokens）：字号与圆角的唯一出处。
         先前这些数值全部内联散落在 7 个 XAML 文件里（84 处 FontSize、65 处
         CornerRadius），想整体调一档字号必须在各文件里逐处找替换。这里把它们
         收敛成命名资源，由 Themes/Controls.xaml 合并引入，全应用共享。

         命名规则：
         - 字号按 十三档 递增，Half 后缀表示该档 +0.5 磅（半磅是刻意的视觉微调，
           例如 12.5 用于「原文件名 → 新文件名」这类等宽对读的行，比 12 略松、
           比 13 略紧），因此档位名与数值一一对应，改名即改全应用。
         - 圆角只收「固定圆角」；圆形头像 / 胶囊 / 滑块的圆角 = 元素宽高的一半
           （如 46px 圆点用 23、20px 滑块用 10），属于几何计算而非设计常量，
           改动元素尺寸时它们必须跟着变，故保留内联，不进令牌层。
         ================================================================== -->

    <!-- ============ 字号令牌 ============ -->
    <sys:Double x:Key="FontSizeTiny">10</sys:Double>          <!-- 角标、极次要的元信息 -->
    <sys:Double x:Key="FontSizeTinyHalf">10.5</sys:Double>    <!-- 「失效」标记、历史状态徽标 -->
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>       <!-- 列表副信息（大小 / 时间）、问题标签 -->
    <sys:Double x:Key="FontSizeCaptionHalf">11.5</sys:Double> <!-- 空状态说明、工具栏按钮 -->
    <sys:Double x:Key="FontSizeBody">12</sys:Double>          <!-- 正文，绝大多数文本 -->
    <sys:Double x:Key="FontSizeBodyHalf">12.5</sys:Double>    <!-- 预览行的新旧名对照 -->
    <sys:Double x:Key="FontSizeSubtitle">13</sys:Double>      <!-- 小节标题、按钮默认字号 -->
    <sys:Double x:Key="FontSizeSubtitleHalf">13.5</sys:Double><!-- 规则卡标题、文件夹名 -->
    <sys:Double x:Key="FontSizeTitle">14</sys:Double>         <!-- 进度窗标题 -->
    <sys:Double x:Key="FontSizeTitleHalf">14.5</sys:Double>   <!-- 二级窗口标题栏 -->
    <sys:Double x:Key="FontSizeHeading">15</sys:Double>       <!-- Toast 标题、拖拽提示 -->
    <sys:Double x:Key="FontSizeHeadingHalf">15.5</sys:Double> <!-- 主窗口标题 -->
    <sys:Double x:Key="FontSizeDisplay">18</sys:Double>       <!-- 关于页产品名 -->

    <!-- ============ 圆角令牌 ============ -->
    <CornerRadius x:Key="RadiusS">4</CornerRadius>    <!-- 标签 chip、行内高亮 -->
    <CornerRadius x:Key="RadiusM">6</CornerRadius>    <!-- 按钮、文本框、行高亮 -->
    <CornerRadius x:Key="RadiusL">8</CornerRadius>    <!-- 窗口边框、卡片、面板 -->
    <CornerRadius x:Key="RadiusXl">10</CornerRadius>  <!-- 大面板 -->
    <CornerRadius x:Key="Radius2Xl">12</CornerRadius> <!-- Toast 浮层 -->

</ResourceDictionary>
