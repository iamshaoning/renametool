# Base URL for SEO (sitemap, OG tags, canonical URLs)
# 部署到 GitHub Pages 项目页时，例如：https://iamshaoning.github.io/renametool
NEXT_PUBLIC_BASE_URL=https://iamshaoning.github.io/renametool

# Base path for GitHub Pages project sites (e.g. /renametool), empty for root
NEXT_PUBLIC_BASE_PATH=/renametool

# Google Analytics Measurement ID (GA4)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Umami Analytics
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Set to "1" to skip environment variable validation (useful for Docker builds)
# SKIP_ENV_VALIDATION=1
