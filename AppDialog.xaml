<local:ToolWindow x:Class="RenameTool.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RenameTool"
        Title="提示"
        Width="580" SizeToContent="Height" MinWidth="340" MaxWidth="580"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="{StaticResource RadiusL}"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- 自绘边框：与主窗口 / 二级窗口统一的外圈细边框；圆角由 DWM 负责裁切 -->
    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusL}"
            Background="{DynamicResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{DynamicResource WindowBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <TextBlock x:Name="TitleText" FontSize="{StaticResource FontSizeTitleHalf}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource ToolCloseButton}"
                            Click="Close_Click" />
                </Grid>
            </Border>

            <!-- 正文：图标居中在上，消息居中在下，再往下是可选自定义内容。
                 采用纵向结构而非「图标在左」，是为了让下方的文件清单能够占满整行宽度，
                 不会因为左侧图标的缩进而整体右移。 -->
            <StackPanel Grid.Row="1" Margin="20,18,20,2">
                <Border x:Name="IconWrap" Width="38" Height="38" CornerRadius="19"
                        HorizontalAlignment="Center">
                    <Path x:Name="IconGlyph" Width="20" Height="20" Stretch="Uniform" Fill="{x:Null}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="MessageText" FontSize="{StaticResource FontSizeSubtitle}" TextWrapping="Wrap" LineHeight="21"
                           Margin="0,12,0,0" TextAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" />
                <ContentPresenter x:Name="ExtraHost" Margin="0,14,0,0" />
            </StackPanel>

            <!-- 按钮行（按调用方传入的按钮动态生成） -->
            <StackPanel x:Name="ButtonPanel" Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="20,18,20,18" />
        </Grid>
    </Border>
</local:ToolWindow>
