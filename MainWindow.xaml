<local:ToolWindow x:Class="RenameTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:RenameTool.Models"
        xmlns:local="clr-namespace:RenameTool"
        Title="批量文件重命名"
        Icon="Assets/app.ico"
        Width="1384" Height="860" MinWidth="1384" MinHeight="860"
        WindowStyle="None" ResizeMode="CanResize"
        AllowDrop="True" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">

    <!-- 无系统边框：由 WindowChrome 提供可调整大小的透明边框，标题栏与按钮全部自绘 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="{StaticResource RadiusL}"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- ============ 全局快捷键（B1）：导入 / 撤销重做 / 全选 / 移除 / 刷新 / 执行 ============ -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="O" Command="{Binding ImportFilesCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="O" Command="{Binding ImportFolderCommand}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}" />
        <KeyBinding Modifiers="Control" Key="A" Command="{Binding SelectAllCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="A" Command="{Binding SelectNoneCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Modifiers="Control" Key="Enter" Command="{Binding ExecuteCommand}" />
        <!-- Ctrl+F 聚焦筛选框：与文件列表的搜索图标对应，属视图行为，故走代码后置的路由命令 -->
        <KeyBinding Modifiers="Control" Key="F" Command="{x:Static local:MainWindow.FocusFilterCommand}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.FocusFilterCommand}" Executed="FocusFilter_Executed" />
    </Window.CommandBindings>

    <Window.Resources>

        <!-- 转换器 -->
        <local:BoolVisibilityConverter x:Key="BoolVis" />
        <local:NotEmptyVisibilityConverter x:Key="NotEmptyVis" />
        <local:IssueBrushConverter x:Key="IssueBrush" />
        <local:IssueTextBrushConverter x:Key="IssueTextBrush" />
        <local:StatusBrushConverter x:Key="StatusBrush" />
        <local:StatusTextConverter x:Key="StatusText" />
        <local:RuleIconConverter x:Key="RuleIcon" />
        <local:IndentGuidesConverter x:Key="IndentGuides" />

        <!-- 层级缩进指示线：每深入一级，行首增加一条 14 像素宽的竖向参考线（类似代码编辑器的缩进参考线） -->
        <Style x:Key="IndentGuideRow" TargetType="ItemsControl">
            <Setter Property="ItemsSource" Value="{Binding Depth, Converter={StaticResource IndentGuides}}" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <!-- 外层为 14 像素宽的缩进格，负外边距让竖线越过行的垂直外边距，
                             使相邻行的参考线首尾相接、连续不断 -->
                        <Border Width="14" Margin="0,-4,0,-4">
                            <!-- 竖线居中于本格，与同级折叠箭头的中心对齐 -->
                            <Rectangle Width="1" HorizontalAlignment="Center"
                                       Fill="{DynamicResource MutedTextBrush}" />
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 规则卡片共用头部样式 -->
        <Style x:Key="RuleToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Margin" Value="2,0" />
            <!-- 规则卡片的提示文字较长，显示时间放宽到 6s（默认 5s）；
                 不宜再长：ToolTip 处于展开状态时鼠标移到别的按钮上会立即切换显示，
                 停留时间过长等于把整条工具栏都变成「划过即弹」。 -->
            <Setter Property="ToolTipService.ShowDuration" Value="6000" />
        </Style>

        <!-- 预览问题标签背景转换器使用的圆点 -->
        <Style x:Key="IssueBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        </Style>

        <!-- 面板标题左侧的墨绿饰条 -->
        <Style x:Key="PanelAccentBar" TargetType="Border">
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="14" />
        </Style>

        <!-- 自定义标题栏的窗口控制按钮（macOS 风格：悬停分别呈黄 / 绿 / 红底色 + 白色图标）
             注意：这里刻意不 BasedOn 基础按钮样式，避免其 IsMouseOver 触发器抢占背景色，
             从而确保三个按钮的悬停彩色一定能生效。悬停底色同样走模板过渡层淡入。 -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <!-- 高度撑满标题栏（44）：实际点击识别区覆盖整个标题栏高度，视觉色块仍固定 34×30（模板中的 Bd） -->
            <Setter Property="Height" Value="44" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 外层透明网格：撑满按钮尺寸，用于扩大命中判定；内层 Bd 固定 34×30 且左上对齐，
                             保证悬停彩色块的视觉尺寸与位置与改造前完全一致 -->
                        <Grid Background="Transparent">
                            <!-- Press 只承载按下态的整块变暗，与悬停层的 Opacity 动画互不干扰 -->
                            <Grid x:Name="Press">
                                <!-- 悬停过渡层压在 Bd 之下：彩色块渐显，图标始终画在最上层 -->
                                <Border x:Name="Hover" Width="34" Height="30" CornerRadius="{StaticResource RadiusM}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{TemplateBinding local:HoverFade.Background}"
                                        Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="Bd" Width="34" Height="30" CornerRadius="{StaticResource RadiusM}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Press" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 最小化按钮：悬停绿 -->
        <Style x:Key="WindowMinButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <!-- 悬停底色由模板过渡层淡入 -->
            <Setter Property="local:HoverFade.Background" Value="#27C93F" />
        </Style>

        <!-- 最大化 / 还原按钮：悬停黄 -->
        <Style x:Key="WindowMaxButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="local:HoverFade.Background" Value="#FFBD2E" />
        </Style>

        <!-- 关闭按钮：悬停 macOS 红 -->
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="local:HoverFade.Background" Value="#FF5F56" />
        </Style>

        <!-- 窗口控制按钮内的图标：三个按钮统一用正文色（与关闭按钮一致，避免显得像禁用），悬停时转白以适配彩底 -->
        <Style x:Key="WindowGlyph" TargetType="Path" BasedOn="{StaticResource IconPath}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Stroke" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 标题栏图标按钮：无边框、悬停仅给一层浅色底，用于「关于」等轻量入口 -->
        <Style x:Key="TitleIconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <!-- 悬停底色：由模板里的过渡层淡入 -->
            <Setter Property="local:HoverFade.Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Press 只承载按下态的整块变暗，与悬停层的 Opacity 动画互不干扰 -->
                        <Grid x:Name="Press">
                            <!-- 悬停过渡层必须画在 Bd 之下：Bd 的 Background 在多数用法里是 Transparent，
                                 悬停色块可以透上来；而图标在 Bd 内，始终压在最上层，不会被浅色底盖住。
                                 （先前把 Hover 放在 Bd 之后，悬停时浅色底直接盖住图标，看起来像图标消失。） -->
                            <Border x:Name="Hover" Background="{TemplateBinding local:HoverFade.Background}"
                                    CornerRadius="{StaticResource RadiusM}" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusM}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Press" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 外观切换滑块：内凹滑动槽 + 凸起滑块，滑块内嵌当前主题图标，三档吸附
             （左 明 / 中 暗 / 右 跟随系统）。
             槽内净宽 90 = 总宽 100 − 左右各 5 内边距，拇指宽 28，
             因此滑动行程 62 恰好均分为两段（每档 31），三档位置对齐、图标清晰可辨。
             IsMoveToPointEnabled：点击滑槽任意位置时滑块直接移到该处，
             因此「明亮 ⇄ 自动」可以一次到位，不必先经夜间档再点第二次；
             配合 IsSnapToTickEnabled，落点始终吸附到最近的那一档。 -->
        <Style x:Key="ThemeSlider" TargetType="Slider">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="2" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <!-- 滑动槽：底槽描边 + 顶部内阴影渐变，营造真实凹陷纵深 -->
                            <Border x:Name="Slot" CornerRadius="13"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" />
                            <Border CornerRadius="12" Margin="1" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3D000000" Offset="0" />
                                        <GradientStop Color="#14000000" Offset="0.55" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="13" Margin="1" IsHitTestVisible="False"
                                    BorderThickness="0,1,0,0" BorderBrush="#1AFFFFFF" />
                            <Grid Margin="5,0">
                                <Track x:Name="PART_Track" VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="28" Height="20">
                                            <!-- 档位切换时的滑动位移（由代码做动画），拖动时置 0 直接跟随鼠标 -->
                                            <Thumb.RenderTransform>
                                                <TranslateTransform x:Name="ThumbSlideX" />
                                            </Thumb.RenderTransform>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid x:Name="KnobRoot" RenderTransformOrigin="0.5,0.5">
                                                        <Grid.RenderTransform>
                                                            <ScaleTransform x:Name="KnobScale" />
                                                        </Grid.RenderTransform>
                                                        <!-- 落影：代替 DropShadowEffect（位图特效在动画中易产生糊边 / 拖影），
                                                             用渐变换色层做一枚柔和贴地投影 -->
                                                        <Border x:Name="KnobShadow" CornerRadius="10" Margin="1,3,1,-2"
                                                                Opacity="0.7" IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#00000000" Offset="0" />
                                                                    <GradientStop Color="#42000000" Offset="0.65" />
                                                                    <GradientStop Color="#00000000" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <!-- 滑块主体 -->
                                                        <Border x:Name="Knob" CornerRadius="10"
                                                                Background="{DynamicResource AccentBrush}"
                                                                BorderBrush="#40FFFFFF" BorderThickness="1" />
                                                        <!-- 滑块高光：上半部渐隐白，模拟受光面 -->
                                                        <Border x:Name="KnobGloss" CornerRadius="9" Margin="1"
                                                                IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#66FFFFFF" Offset="0" />
                                                                    <GradientStop Color="#14FFFFFF" Offset="0.55" />
                                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <!-- 滑块内嵌当前主题图标（随档位切换） -->
                                                        <Path x:Name="ThemeIcon" Width="14" Height="14"
                                                              Stretch="Uniform" Fill="{x:Null}"
                                                              Stroke="#FFFFFFFF" StrokeThickness="1.6"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Data="{StaticResource Icon.Monitor}" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}}" Value="0">
                                                            <Setter TargetName="ThemeIcon" Property="Data" Value="{StaticResource Icon.Sun}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}}" Value="1">
                                                            <Setter TargetName="ThemeIcon" Property="Data" Value="{StaticResource Icon.Moon}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}}" Value="2">
                                                            <Setter TargetName="ThemeIcon" Property="Data" Value="{StaticResource Icon.Monitor}" />
                                                        </DataTrigger>
                                                        <!-- 悬停：滑块微微浮起（缩放 + 投影加深），像真实按键被指尖触碰 -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                                         Storyboard.TargetProperty="ScaleX"
                                                                                         To="1.08" Duration="0:0:0.14">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                                         Storyboard.TargetProperty="ScaleY"
                                                                                         To="1.12" Duration="0:0:0.14">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="KnobShadow"
                                                                                         Storyboard.TargetProperty="Opacity"
                                                                                         To="1" Duration="0:0:0.14" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                                         Storyboard.TargetProperty="ScaleX"
                                                                                         To="1" Duration="0:0:0.16">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                                         Storyboard.TargetProperty="ScaleY"
                                                                                         To="1" Duration="0:0:0.16">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetName="KnobShadow"
                                                                                         Storyboard.TargetProperty="Opacity"
                                                                                         To="0.7" Duration="0:0:0.16" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                        </Trigger>
                                                        <!-- 按住：滑块被压下（变扁），松手回弹 -->
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                                         Storyboard.TargetProperty="ScaleY"
                                                                                         To="0.92" Duration="0:0:0.08" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="KnobScale"
                                                                                         Storyboard.TargetProperty="ScaleY"
                                                                                         To="1.12" Duration="0:0:0.12">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Slot" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具栏分组竖分隔线 -->
        <Style x:Key="ToolSep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 工具栏按钮内的图标：颜色跟随所属按钮的前景色，悬停反色时同步变化 -->
        <Style x:Key="ToolIconPath" TargetType="Path" BasedOn="{StaticResource IconPath}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <!-- 工具栏按钮通用尺寸：紧凑「图标 + 文字」 -->
        <Style x:Key="ToolButtonBase" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <!-- 同 RuleToolButton：提示文字较长，6s 足够读完，又不会长时间压着别的按钮 -->
            <Setter Property="ToolTipService.ShowDuration" Value="6000" />
        </Style>

        <!-- 中性工具按钮（刷新 / 全不选 等次要操作） -->
        <Style x:Key="ListToolButton" TargetType="Button" BasedOn="{StaticResource ToolButtonBase}" />

        <!-- 彩色工具按钮：柔和底色 + 同色图标文字；悬停转为实色底 + 面板色前景，恢复彩色观感。
             底色变化交给模板过渡层淡入；前景与描边仍是即时切换（0.14s 缓出前段已接近终色）。 -->
        <Style x:Key="ToolAccentButton" TargetType="Button" BasedOn="{StaticResource ToolButtonBase}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="local:HoverFade.Background" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolSuccessButton" TargetType="Button" BasedOn="{StaticResource ToolButtonBase}">
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessSoftBrush}" />
            <Setter Property="local:HoverFade.Background" Value="{DynamicResource SuccessBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolDangerButton" TargetType="Button" BasedOn="{StaticResource ToolButtonBase}">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="local:HoverFade.Background" Value="{DynamicResource DangerBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 数字输入框右侧的“增加 / 减少”小按钮：用 RepeatButton 以支持按住连续增减 -->
        <Style x:Key="SpinButton" TargetType="RepeatButton">
            <Setter Property="Width" Value="16" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="14" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" />
                            <!-- 悬停 / 按下各占一层，都只动画 Opacity：按下色叠在悬停色之上，层次与原先「后声明的触发器生效」一致 -->
                            <Border x:Name="Hover" Background="{DynamicResource SurfaceHoverBrush}"
                                    CornerRadius="3" Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="Pressed" Background="{DynamicResource SurfaceAltBrush}"
                                    CornerRadius="3" Opacity="0" IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Pressed" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Pressed" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文件列表失效条目的删除按钮：平时淡显示，悬停变红底 -->
        <Style x:Key="RowDeleteButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <!-- 悬停底色：由基础按钮模板里的过渡层淡入 -->
            <Setter Property="local:HoverFade.Background" Value="{DynamicResource DangerSoftBrush}" />
        </Style>

        <!-- 预览行的图标按钮（如锁定目标名）：平时淡显示，悬停显示浅色底 -->
        <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <!-- 悬停底色：由基础按钮模板里的过渡层淡入 -->
            <Setter Property="local:HoverFade.Background" Value="{DynamicResource SurfaceAltBrush}" />
        </Style>

        <!-- 数字输入框：右侧带可点击的上下箭头（TextBox.Tag 为允许的最小值） -->
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,0,16,0" />
            <!-- 宽度下限：保证任何数字框都能完整显示三位半数字（如 999.5），不会被右侧箭头挤掉 -->
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource RadiusM}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Width="16" Background="Transparent">
                                    <RepeatButton Style="{StaticResource SpinButton}" Tag="1"
                                                  Delay="400" Interval="70"
                                                  Click="NumberSpin_Click" ToolTip="增加">
                                        <Path Data="{StaticResource Icon.ChevronUp}" Stretch="Uniform" Width="8" Height="8"
                                              Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </RepeatButton>
                                    <RepeatButton Style="{StaticResource SpinButton}" Tag="-1"
                                                  Delay="400" Interval="70"
                                                  Click="NumberSpin_Click" ToolTip="减少">
                                        <Path Data="{StaticResource Icon.ChevronDown}" Stretch="Uniform" Width="8" Height="8"
                                              Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </RepeatButton>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 预览头部“冲突”统计：无冲突时弱化，有冲突时醒目标红 -->
        <Style x:Key="ConflictStat" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Conflicts}" Value="0">
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============ 文件列表行模板：文件夹模块（表头 + 自带容器，容器可层层嵌套） ============ -->
        <DataTemplate DataType="{x:Type m:FolderNode}">
            <!-- 文件夹模块 = 表头 + 该文件夹专属的展示容器。容器内又是完整的模块，
                 因此容器可以一层包一层，天然支持任意层级嵌套。 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 表头：点击折叠 / 展开下方容器 -->
                <Grid Grid.Row="0" MinHeight="30" Margin="0,3,4,1" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonUp="FolderHeader_MouseLeftButtonUp"
                      ToolTip="{Binding FullPath}">
                    <Grid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="展开 / 折叠" Click="FolderToggle_Click" />
                            <Separator />
                            <MenuItem Header="在资源管理器中打开" Click="FolderReveal_Click" />
                            <MenuItem Header="复制完整路径" Click="CopyFullPath_Click" />
                            <Separator />
                            <MenuItem Header="移除该文件夹下的文件" Click="RemoveFolderRows_Click" />
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 层级缩进指示线：每深入一级，行首绘制一条竖向参考线 -->
                    <ItemsControl Grid.Column="0" Style="{StaticResource IndentGuideRow}" />
                    <!-- 折叠箭头：展开时向下，折叠时指向右侧（与规则卡片同一图标样式，确保清晰可见） -->
                    <Grid Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center">
                        <Path Style="{StaticResource IconPathMuted}" Width="13" Height="13"
                              Data="{StaticResource Icon.ChevronDown}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}" />
                        <Path Style="{StaticResource IconPathMuted}" Width="13" Height="13"
                              Data="{StaticResource Icon.ChevronRight}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                    </Grid>
                    <CheckBox Grid.Column="2" Margin="6,0,6,0" VerticalAlignment="Center"
                              IsThreeState="True"
                              IsChecked="{Binding SelectionState, Mode=OneWay}"
                              Click="FolderCheckBox_Click"
                              ToolTip="选择 / 取消选择该文件夹下的文件（不含失效项）" />
                    <TextBlock Grid.Column="3" Text="{Binding Name}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding TotalCount, StringFormat={}{0}个文件}" Margin="6,0,0,0"
                               FontSize="{StaticResource FontSizeTinyHalf}" Foreground="{DynamicResource FaintTextBrush}"
                               VerticalAlignment="Center" ToolTip="该文件夹（含子文件夹）的文件数" />
                    <Border Grid.Column="5" Margin="6,0,0,0" Padding="5,1" CornerRadius="3"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceAltBrush}"
                            ToolTip="该文件夹的导入来源">
                        <TextBlock Text="{Binding SourceText}" FontSize="{StaticResource FontSizeTiny}"
                                   Foreground="{DynamicResource FaintTextBrush}" />
                    </Border>
                </Grid>

                <!-- 本文件夹的专属容器：承载本层文件与子文件夹。折叠 / 展开时由视图层对整块容器做
                     「高度裁剪」动画，容器整体向上卷起 / 卷开，动画结束后才真正隐藏，
                     因此不会出现行各自为政或整体突消失。ClipToBounds 保证卷动过程内容被裁掉而不是溢出。 -->
                <Border Grid.Row="1" ClipToBounds="True"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ============ 文件列表行模板 ============ -->
        <DataTemplate DataType="{x:Type m:FileItem}">
            <Grid MinHeight="34" Margin="0,1,4,1" Background="Transparent">
                <!-- 右键菜单（B2）：针对单个文件的操作 -->
                <Grid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="打开所在文件夹" Click="RevealInExplorer_Click" />
                        <MenuItem Header="复制完整路径" Click="CopyFullPath_Click" />
                        <MenuItem Header="复制文件名" Click="CopyFileName_Click" />
                        <Separator />
                        <MenuItem Header="从列表移除" Click="RemoveFileRow_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>
                <!-- 层级缩进指示线：比所属文件夹再深一级，使复选框与文件夹复选框精确对齐 -->
                <ItemsControl Grid.Column="0" Style="{StaticResource IndentGuideRow}" />
                <!-- 有效条目：可选择；失效条目：不可选择，改为删除按钮 -->
                <CheckBox Grid.Column="1" IsChecked="{Binding Selected}" Margin="6,0,0,0"
                          VerticalAlignment="Center" HorizontalAlignment="Left"
                          Visibility="{Binding IsMissing, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                <Button Grid.Column="1" Style="{StaticResource RowDeleteButton}" Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        ToolTip="从列表移除该失效条目"
                        Visibility="{Binding IsMissing, Converter={StaticResource BoolVis}}">
                    <Path Style="{StaticResource IconPathDanger}" Width="13" Height="13"
                          Data="{StaticResource Icon.Trash2}" />
                </Button>
                <Grid Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="{StaticResource FontSizeSubtitle}"
                               VerticalAlignment="Center" ToolTip="{Binding Name}"
                               Cursor="Hand" MouseLeftButtonUp="NameText_MouseLeftButtonUp">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Style.Triggers>
                                    <!-- 点击名称：切换为自动换行完整显示 -->
                                    <DataTrigger Binding="{Binding IsNameExpanded}" Value="True">
                                        <Setter Property="TextTrimming" Value="None" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </DataTrigger>
                                    <!-- 文件已失效（被删除 / 改名）：标红加删除线 -->
                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Grid.Column="1" Margin="6,0,0,0" Padding="5,0" CornerRadius="3"
                            VerticalAlignment="Center"
                            Background="{DynamicResource DangerSoftBrush}"
                            Visibility="{Binding IsMissing, Converter={StaticResource BoolVis}}"
                            ToolTip="文件已不存在，执行时将被跳过">
                        <TextBlock Text="失效" FontSize="{StaticResource FontSizeTinyHalf}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SizeText}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource MutedTextBrush}"
                               TextAlignment="Right" />
                    <TextBlock Text="{Binding ModifiedText}" FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource FaintTextBrush}"
                               TextAlignment="Right" Margin="0,1,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ============ 预览结果行模板（旧名 → 新名） ============ -->
        <DataTemplate x:Key="PreviewRowTemplate">
            <Grid Margin="2,3">
                <StackPanel Background="Transparent">
                <!-- 右键菜单（B2）：复制改名结果 / 定位源文件 -->
                <StackPanel.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="复制新文件名" Click="CopyNewName_Click" />
                        <MenuItem Header="复制“旧名 → 新名”" Click="CopyPair_Click" />
                        <Separator />
                        <MenuItem Header="打开所在文件夹" Click="RevealInExplorer_Click" />
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <!-- 所在文件夹：单独一行，便于把宽度让给文件名 -->
                <TextBlock Text="{Binding DirDisplay}" FontSize="{StaticResource FontSizeSubtitleHalf}" FontWeight="SemiBold" Margin="0,0,0,3"
                           Foreground="{DynamicResource TextBrush}"
                           ToolTip="{Binding File.Directory}"
                           Cursor="Hand" MouseLeftButtonUp="NameText_MouseLeftButtonUp">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DirDisplay}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!-- 点击名称：切换为自动换行完整显示 -->
                                <DataTrigger Binding="{Binding IsNameExpanded}" Value="True">
                                    <Setter Property="TextTrimming" Value="None" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 锁定特效只覆盖“旧名 → 新名”这一行，不再包含上方的文件夹名行。
                     竖条固定在行首 3px、内容整体左缩进 10 —— 竖条不压文字，
                     且是否锁定都保持同样缩进，切换锁定状态时文字不会左右跳动。 -->
                <Grid>
                    <Border CornerRadius="{StaticResource RadiusM}" Margin="0,1,0,1" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,1,0,1"
                            Background="{DynamicResource AccentBrush}" IsHitTestVisible="False"
                            Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}" />

                    <Grid Margin="10,0,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <!-- 未勾选（不参与改名）的文件：仅行内容置灰，文件夹名行保持正常 -->
                                <DataTrigger Binding="{Binding IsInScope}" Value="False">
                                    <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding OriginalName}" FontSize="{StaticResource FontSizeBodyHalf}"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" ToolTip="{Binding OriginalName}"
                               Cursor="Hand" MouseLeftButtonUp="NameText_MouseLeftButtonUp">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextDecorations" Value="None" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasChange}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                    </DataTrigger>
                                    <!-- 点击名称：切换为自动换行完整显示 -->
                                    <DataTrigger Binding="{Binding IsNameExpanded}" Value="True">
                                        <Setter Property="TextTrimming" Value="None" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="1" Text="→" Margin="8,0,8,0" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeBody}" Foreground="{DynamicResource FaintTextBrush}" />

                    <TextBlock Grid.Column="2" Text="{Binding NewName}" FontSize="{StaticResource FontSizeBodyHalf}"
                               VerticalAlignment="Center"
                               ToolTip="{Binding NewName}"
                               Cursor="Hand" MouseLeftButtonUp="NameText_MouseLeftButtonUp">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasChange}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <!-- 点击名称：切换为自动换行完整显示 -->
                                    <DataTrigger Binding="{Binding IsNameExpanded}" Value="True">
                                        <Setter Property="TextTrimming" Value="None" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 问题徽标：无问题时整体折叠（否则会留一个空文本的透明底占位，白白吃 12px 宽度） -->
                    <Border Grid.Column="3" Margin="8,0,0,0"
                            Background="{Binding Issue, Converter={StaticResource IssueBrush}}"
                            ToolTip="{Binding IssueText}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource IssueBadge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Issue}" Value="{x:Static m:PreviewIssue.None}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding IssueText}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                   Foreground="{Binding Issue, Converter={StaticResource IssueTextBrush}}" />
                    </Border>

                    <!-- 目标名锁定开关：未锁定时点击锁定当前新名（此后不随规则变化）；已锁定时点击解除 -->
                    <Button Grid.Column="4" Style="{StaticResource RowIconButton}" Margin="4,0,0,0"
                            Command="{Binding DataContext.LockPreviewNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="未锁定目标名：点击锁定，锁定后不随规则变化"
                            Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <Path Style="{StaticResource IconPathMuted}" Width="16" Height="16"
                              Data="{StaticResource Icon.Unlock}" />
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource RowIconButton}" Margin="4,0,0,0"
                            Command="{Binding DataContext.UnlockPreviewNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="已锁定目标名：点击解除锁定"
                            Visibility="{Binding IsLocked, Converter={StaticResource BoolVis}}">
                        <Path Style="{StaticResource IconPathAccent}" Width="16" Height="16"
                              Data="{StaticResource Icon.Lock}" />
                    </Button>
                    </Grid>
                </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ============ 日志行模板（成功/失败 · 原名 · 箭头 · 新名称或失败原因） ============ -->
        <DataTemplate x:Key="LogRowTemplate">
            <Grid Margin="2,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                           Text="{Binding Status, Converter={StaticResource StatusText}}" />
                <TextBlock Grid.Column="1" FontSize="{StaticResource FontSizeBodyHalf}" Foreground="{DynamicResource TextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           Text="{Binding Original}" ToolTip="{Binding Original}"
                           Cursor="Hand" MouseLeftButtonUp="NameText_MouseLeftButtonUp">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                            <Style.Triggers>
                                <!-- 点击名称：切换为自动换行完整显示 -->
                                <DataTrigger Binding="{Binding IsNameExpanded}" Value="True">
                                    <Setter Property="TextTrimming" Value="None" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="→" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" />
                <!-- 成功显示新名称；失败显示失败原因 -->
                <TextBlock Grid.Column="3" FontSize="{StaticResource FontSizeBodyHalf}" VerticalAlignment="Center"
                           Text="{Binding Result}" ToolTip="{Binding Result}"
                           Cursor="Hand" MouseLeftButtonUp="NameText_MouseLeftButtonUp">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="failed">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                                <!-- 点击名称：切换为自动换行完整显示 -->
                                <DataTrigger Binding="{Binding IsNameExpanded}" Value="True">
                                    <Setter Property="TextTrimming" Value="None" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- ============ 模块化编辑区（名称模板 / 替换为 / 插入文本共用） ============
             DataContext 为 SegmentEditor：文本段可直接输入，变量段作为可拖拽 / 可删除的模块。 -->
        <DataTemplate x:Key="SegmentChips">
            <!-- 尺寸刻意对齐普通输入框（最小高度 30），且上下「内边距 1 + 边框 2 = 3」
                 与上一版的「内边距 2 + 边框 1 = 3」在高度上完全等价：
                 勾选“使用变量”前后编辑区占据的高度完全一致，下方选项不会上下跳动，
                 同时边框保持 2px 的视觉厚度，不至于比普通输入框显得单薄。 -->
            <Border Margin="0,4,0,0" MinHeight="30" Padding="6,1"
                    Background="{DynamicResource InputBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2"
                    CornerRadius="{StaticResource RadiusM}">
                <ItemsControl ItemsSource="{Binding Segments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid PreviewMouseLeftButtonDown="SegmentChip_MouseDown"
                                  PreviewMouseMove="SegmentChip_MouseMove">
                                <!-- 文本片段：内联编辑，宽度随内容自适应 -->
                                <Grid x:Name="TextHost" Margin="0,1" VerticalAlignment="Center">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlainText}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <!-- 变量模式（禁止内联输入）下，空文本段不可输入，隐藏以免留下点不动的空白 -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Tag.AllowInlineInput, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="False" />
                                                        <Condition Binding="{Binding Value}" Value="" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                                <!-- 已插入模块（变量 / 自定义文本）时隐藏末尾空文本段，避免拖拽到末尾后空白跑到模块左侧 -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Value}" Value="" />
                                                        <Condition Binding="{Binding DataContext.HasModule, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <TextBlock Text="{Binding Value}" FontSize="{StaticResource FontSizeSubtitle}" Visibility="Hidden"
                                               Margin="0,0,2,0" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="{StaticResource FontSizeSubtitle}" MinWidth="20" MinHeight="0" Padding="0"
                                             BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             ToolTip="直接输入固定文字">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <!-- 变量模式：内联文本段不再接受光标与输入，改用“自定义文本”模块 -->
                                                    <DataTrigger Binding="{Binding Tag.AllowInlineInput, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                                                 Value="False">
                                                        <Setter Property="IsHitTestVisible" Value="False" />
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>

                                <!-- 变量模块 -->
                                <Border x:Name="Chip" Margin="1,1" Padding="6,2" CornerRadius="{StaticResource RadiusS}"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        Cursor="SizeAll" VerticalAlignment="Center"
                                        ToolTip="按住拖动可调整顺序，点击 × 删除此模块">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVariable}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Value}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button Click="TemplateChipRemove_Click" Width="14" Height="14"
                                                MinWidth="0" MinHeight="0" Padding="0" Margin="4,0,0,0"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTip="删除此模块">
                                            <Path Data="{StaticResource Icon.X}" Width="9" Height="9"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.4"
                                                  Stretch="Uniform"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- 自定义文本模块：内含独立的自适应文本框，点击即可编辑内容 -->
                                <Border x:Name="CustomChip" Margin="3,2" Padding="3,1" CornerRadius="{StaticResource RadiusS}"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                        VerticalAlignment="Center"
                                        ToolTip="点击文字可编辑内容，点击 × 删除此模块">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustom}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid>
                                            <!-- 隐藏的 TextBlock 用于按内容撑开宽度，使文本框自适应 -->
                                            <TextBlock Text="{Binding Value}" FontSize="{StaticResource FontSizeSubtitle}" Visibility="Hidden"
                                                       MinWidth="24" Margin="3,0" />
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="{StaticResource FontSizeSubtitle}" MinWidth="24" MinHeight="0" Padding="3,0"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalContentAlignment="Center"
                                                     ToolTip="输入自定义文本" />
                                        </Grid>
                                        <Button Click="TemplateChipRemove_Click" Width="14" Height="14"
                                                MinWidth="0" MinHeight="0" Padding="0" Margin="4,0,0,0"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTip="删除此模块">
                                            <Path Data="{StaticResource Icon.X}" Width="9" Height="9"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.4"
                                                  Stretch="Uniform"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>

        <!-- 可用变量按钮区：点击后以模块形式插入所在编辑区（由祖先元素的 Tag 指明目标）。 -->
        <DataTemplate x:Key="VariablePicker">
            <StackPanel Margin="0,4,0,0">
                <ItemsControl ItemsSource="{x:Static m:TemplateVariables.All}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="VariableButton_Click" Tag="{Binding Token}"
                                    Margin="0,0,6,6" Padding="8,1" MinHeight="24" FontSize="{StaticResource FontSizeCaptionHalf}"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    ToolTip="{Binding Description}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Token}" Margin="6,0,0,0" FontSize="{StaticResource FontSizeTinyHalf}"
                                               Foreground="{DynamicResource FaintTextBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Click="CustomTextButton_Click" HorizontalAlignment="Left"
                        Margin="0,0,6,0" Padding="8,1" MinHeight="24" FontSize="{StaticResource FontSizeCaptionHalf}"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource AccentBrush}"
                        ToolTip="插入一个可自由编辑的自定义文本模块">
                    <TextBlock Text="自定义文本" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- ================= 七类规则编辑器模板 ================= -->
        <!-- 查找替换（含正则） -->
        <DataTemplate x:Key="EditorFindReplace">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="查找内容" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.Find, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="默认按字面查找；开启“使用变量”后按正则表达式匹配" />

                <!-- A5：正则实时校验——语法非法时立刻红字提示，避免执行时静默跳过 -->
                <!-- E4：提示首次出现时整行抖一下，视线在别的输入框也能察觉 -->
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"
                           Text="{Binding Config.RegexError}"
                           local:Shake.On="{Binding Config.RegexError}"
                           Visibility="{Binding Config.RegexError, Converter={StaticResource NotEmptyVis}}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="替换为" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <!-- 未开启变量模式：完全普通的输入框（外边距与变量编辑区一致，切换时不跳动） -->
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,0"
                         Text="{Binding Config.Replace, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding Config.UseRegex, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                         ToolTip="默认按字面替换；开启“使用变量”后可插入变量模块" />
                <!-- 开启变量模式：变量块编辑区 -->
                <ContentControl Grid.Row="3" Grid.Column="1"
                                Content="{Binding ReplaceEditor}"
                                ContentTemplate="{StaticResource SegmentChips}"
                                Tag="{Binding Config}"
                                Visibility="{Binding Config.UseRegex, Converter={StaticResource BoolVis}}" />

                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,0">
                    <CheckBox Content="区分大小写" IsChecked="{Binding Config.CaseSensitive}" Margin="0,0,14,0" />
                    <CheckBox Content="替换全部" IsChecked="{Binding Config.MatchAll}" Margin="0,0,14,0"
                              ToolTip="不勾选则仅替换第一处" />
                    <CheckBox Content="使用变量" IsChecked="{Binding Config.UseRegex}"
                              Click="VarMode_CheckBox_Click"
                              ToolTip="开启后支持正则表达式，并可在“替换为”中使用变量模块与 $1、$2 反向引用" />
                </StackPanel>

                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                            Tag="ReplaceTarget"
                            Visibility="{Binding Config.UseRegex, Converter={StaticResource BoolVis}}">
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                               Text="支持正则表达式，支持 $1 $2… 反向引用" />
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{Binding Config.RegexGroups}"
                               Visibility="{Binding Config.RegexGroups, Converter={StaticResource NotEmptyVis}}" />
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="点击可向“替换为”中添加变量模块" />
                    <ContentControl ContentTemplate="{StaticResource VariablePicker}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 插入文本 -->
        <DataTemplate x:Key="EditorInsert">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="插入文本" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <!-- 未开启变量模式：完全普通的输入框（外边距与变量编辑区一致，切换时不跳动） -->
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4,0,0"
                             Text="{Binding Config.Text, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding Config.UseVariables, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                             ToolTip="默认按字面插入固定文字；开启“使用变量”后可插入变量模块" />
                    <!-- 开启变量模式：变量块编辑区 -->
                    <ContentControl Grid.Row="0" Grid.Column="1"
                                    Content="{Binding InsertEditor}"
                                    ContentTemplate="{StaticResource SegmentChips}"
                                    Tag="{Binding Config}"
                                    Visibility="{Binding Config.UseVariables, Converter={StaticResource BoolVis}}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="插入位置" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <ComboBox Width="110" ItemsSource="{x:Static m:EnumUi.InsertPositions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Config.InsertAt}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Config.InsertAt}" Value="{x:Static m:InsertPosition.Index}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="左起第" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,4,0" />
                            <TextBox Width="76" Style="{StaticResource NumberBox}" Tag="0"
                                     Text="{Binding Config.InsertIndex, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="位" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Content="使用变量"
                              IsChecked="{Binding Config.UseVariables}"
                              Click="VarMode_CheckBox_Click"
                              ToolTip="开启后可在“插入文本”中使用变量模块" />
                </Grid>

                <!-- 可用变量：点击后以模块形式插入到上方编辑区（勾选“使用变量”后显示） -->
                <StackPanel Tag="InsertTarget" Margin="0,8,0,0"
                            Visibility="{Binding Config.UseVariables, Converter={StaticResource BoolVis}}">
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                               Text="点击可向“插入文本”中添加变量模块" />
                    <ContentControl ContentTemplate="{StaticResource VariablePicker}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 序号 -->
        <DataTemplate x:Key="EditorSequence">
            <StackPanel>
                <!-- 四列栅格：标签 80 + 控件，一行放两组。
                     原先每个数值项各占一行、90px 输入框右侧大片留白，纵向拉得过长又显得散；
                     现在短的数值项两两并排、下拉框同行，右列自然撑满，行数由 5 行压到 4 行。 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="序号类型" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Width="150" HorizontalAlignment="Left"
                              ItemsSource="{x:Static m:EnumUi.SeqTypes}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Config.SeqType}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="起始序号" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                             Style="{StaticResource NumberBox}" Tag="0"
                             Text="{Binding Config.Start, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="递增步长" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="3" Width="90" HorizontalAlignment="Left"
                             Style="{StaticResource NumberBox}" Tag="1"
                             Text="{Binding Config.Step, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="相邻文件序号的增量，如设为 2 则序号为 1、3、5" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="数字位数" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                             Style="{StaticResource NumberBox}" Tag="1"
                             Text="{Binding Config.Padding, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="序号不足位数时左侧补 0，如 3 位 → 001" />

                    <TextBlock Grid.Row="4" Grid.Column="2" Text="分隔符" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="3" Width="90" HorizontalAlignment="Left"
                             ToolTip="序号与原名之间插入的字符；留空则直接相连"
                             Text="{Binding Config.Separator, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="加入位置" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="6" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                              ItemsSource="{x:Static m:EnumUi.SeqPositions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Config.SeqPosition}" />

                    <TextBlock Grid.Row="6" Grid.Column="2" Text="编号范围" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                               ToolTip="决定连续编号如何分组，各组都从“起始序号”重新开始" />
                    <ComboBox Grid.Row="6" Grid.Column="3" ItemsSource="{x:Static m:EnumUi.SeqScopes}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Config.Scope}"
                              ToolTip="全部文件：共用一组序号。&#10;每个文件夹：按所在文件夹分别编号。&#10;按扩展名：按 .jpg / .png 等扩展名分组编号。" />
                </Grid>

                <CheckBox Content="编号前先排序" Margin="0,10,0,0" IsChecked="{Binding Config.SortBeforeNumbering}"
                          ToolTip="勾选后可指定编号顺序：排序依据（名称 / 大小 / 修改时间 / 扩展名）与升序、反向编号" />
                <!-- 排序选项缩进到与上方控件同一列，避免勾选后多出一块贴左边的内容 -->
                <Grid Margin="0,6,0,0" Visibility="{Binding Config.SortBeforeNumbering, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="排序依据" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                              ItemsSource="{x:Static m:EnumUi.SeqSorts}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Config.SortBy}" />

                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <CheckBox Content="升序（取消则反向编号）" IsChecked="{Binding Config.SortAscending}" Margin="0,0,14,0"
                                  ToolTip="按上方“排序依据”的顺序依次分配序号；取消勾选即反向编号（例如最后一个文件拿到起始序号）" />
                        <CheckBox Content="自然排序" IsChecked="{Binding Config.NaturalSort}"
                                  ToolTip="文件名中的数字按数值比较：file2 排在 file10 之前" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- 大小写处理 -->
        <DataTemplate x:Key="EditorCaseStyle">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="大小写" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static m:EnumUi.CaseModes}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Config.CaseMode}"
                          ToolTip="转换英文字母的大小写，不改动空格、连字符等其他字符" />

                <TextBlock Grid.Row="2" Text="分隔符" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static m:EnumUi.WordStyles}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Config.WordStyle}"
                          ToolTip="在空格、连字符、下划线之间互转，不改变字母大小写" />
            </Grid>
        </DataTemplate>

        <!-- 名称模板 -->
        <DataTemplate x:Key="EditorNameTemplate">
            <StackPanel>
                <TextBlock Text="名称模板" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />

                <!-- 模块化编辑区：文本段可直接输入，变量段为可拖拽 / 可整体删除的模块 -->
                <ContentControl Content="{Binding TemplateEditor}"
                                ContentTemplate="{StaticResource SegmentChips}"
                                Tag="{Binding Config}" />

                <!-- 可用变量：平铺显示，点击即插入到上方编辑区 -->
                <StackPanel Tag="TemplateTarget" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource HintText}" Text="点击可向模版框中添加变量模块" />
                    <ContentControl ContentTemplate="{StaticResource VariablePicker}" />
                </StackPanel>

                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="示例"  />
                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="　{name}_{n} →　报告_1.txt" />
                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="　{date}_{name} →　2026-09-10_报告.txt" />
                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="　第{n}章-{name} →　第1章-报告.txt" />
            </StackPanel>
        </DataTemplate>

        <!-- 删除清洗 -->
        <DataTemplate x:Key="EditorRemoveCleanup">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="模式"
                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{x:Static m:EnumUi.CleanupModes}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Config.CleanupMode}" />

                <!-- 按字符类别清除 -->
                <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Config.CleanupMode}" Value="{x:Static m:CleanupMode.Cleanup}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                    <CheckBox Content="数字" IsChecked="{Binding Config.RemoveDigits}" Margin="0,0,12,4" />
                    <CheckBox Content="英文" IsChecked="{Binding Config.RemoveEnglish}" Margin="0,0,12,4" />
                    <CheckBox Content="中文" IsChecked="{Binding Config.RemoveChinese}" Margin="0,0,12,4" />
                    <CheckBox Content="空格" IsChecked="{Binding Config.RemoveSpaces}" Margin="0,0,12,4" />
                    <CheckBox Content="符号" IsChecked="{Binding Config.RemoveSymbols}" Margin="0,0,0,4" />
                </WrapPanel>

                <!-- 端部删除：方向 + 删除个数 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="方向"
                           VerticalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Config.CleanupMode}" Value="{x:Static m:CleanupMode.Chars}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Config.CleanupMode}" Value="{x:Static m:CleanupMode.Chars}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ComboBox Width="80" ItemsSource="{x:Static m:EnumUi.Directions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Config.Direction}" />
                    <TextBlock Text="删除个数" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="14,0,6,0" />
                    <TextBox Width="76" Style="{StaticResource NumberBox}" Tag="0"
                             Text="{Binding Config.CharCount, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 区间删除 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="区间"
                           VerticalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Config.CleanupMode}" Value="{x:Static m:CleanupMode.Range}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Config.CleanupMode}" Value="{x:Static m:CleanupMode.Range}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBox Width="76" Style="{StaticResource NumberBox}" Tag="0"
                             Text="{Binding Config.RangeStart, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="—" Margin="8,0" VerticalAlignment="Center" />
                    <TextBox Width="76" Style="{StaticResource NumberBox}" Tag="0"
                             Text="{Binding Config.RangeEnd, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="含两侧端点" Style="{StaticResource HintText}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 成对交换 -->
        <DataTemplate x:Key="EditorPairSwap">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="配对方式" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{x:Static m:EnumUi.PairSwapModes}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Config.SwapMode}"
                              ToolTip="相邻两两交换：第 1↔第 2、第 3↔第 4……；整体轮换：每个文件取下一个文件的名称，最后一个取第一个的" />
                </Grid>

                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="把参与本规则的文件按左侧列表顺序配对，互相拿走对方的名称。配对顺序即列表顺序，可用左侧「导入顺序 / 名称排序」调整。" />
                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="示例：a.txt、b.txt 相邻两两交换 → a.txt 改名为 b.txt、b.txt 改名为 a.txt。" />
                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="相邻两两交换时文件个数为奇数，最后一个落单的文件保持原名；整体轮换不受个数限制。" />
            </StackPanel>
        </DataTemplate>

        <!-- ============ 单条规则卡片（按 Type 切换编辑器模板） ============ -->
        <DataTemplate x:Key="RuleCardTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusL}"
                    Background="{DynamicResource CardBrush}" Margin="0,0,0,8" Padding="12"
                    PreviewMouseLeftButtonDown="RuleCard_MouseDown"
                    PreviewMouseMove="RuleCard_MouseMove">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="启用此规则" IsCheckable="True" IsChecked="{Binding Enabled}" />
                        <Separator />
                        <MenuItem Header="复制此规则" Click="RuleDuplicate_Click" />
                        <MenuItem Header="上移" Click="RuleMoveUp_Click" />
                        <MenuItem Header="下移" Click="RuleMoveDown_Click" />
                        <Separator />
                        <MenuItem Header="删除此规则" Click="RuleRemove_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- 未启用：整体灰化 -->
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter Property="Opacity" Value="{StaticResource DisabledOpacity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- 卡片头部 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Margin="0,0,9,0" Width="20" Height="20"
                              Style="{StaticResource IconPathAccent}"
                              Data="{Binding Type, Converter={StaticResource RuleIcon}}" />

                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding TypeLabel}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubtitleHalf}"
                                   Foreground="{DynamicResource TextBrush}" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RuleToolButton}" ToolTip="上移此规则"
                                    Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource Icon.ChevronUp}" />
                            </Button>
                            <Button Style="{StaticResource RuleToolButton}" ToolTip="下移此规则"
                                    Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource Icon.ChevronDown}" />
                            </Button>
                            <Button Style="{StaticResource RuleToolButton}" ToolTip="复制此规则"
                                    Command="{Binding DataContext.DuplicateRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource Icon.Copy}" />
                            </Button>
                            <Button Style="{StaticResource RuleToolButton}" ToolTip="删除此规则"
                                    Click="RuleRemoveButton_Click">
                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource Icon.X}"
                                      Stroke="{DynamicResource DangerBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 第二行：启用开关 + 作用范围 -->
                    <Grid Margin="0,6,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="启用" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock Grid.Column="1" Text="作用" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="2" HorizontalAlignment="Left" Width="120"
                                  ItemsSource="{x:Static m:EnumUi.Scopes}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Scope}" />
                    </Grid>

                    <!-- 分隔线 -->
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,8" />

                    <!-- 按规则类型切换编辑区 -->
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate"
                                        Value="{StaticResource EditorFindReplace}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static m:RuleType.FindReplace}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource EditorFindReplace}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static m:RuleType.Insert}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource EditorInsert}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static m:RuleType.Sequence}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource EditorSequence}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static m:RuleType.CaseStyle}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource EditorCaseStyle}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static m:RuleType.NameTemplate}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource EditorNameTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static m:RuleType.RemoveCleanup}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource EditorRemoveCleanup}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static m:RuleType.PairSwap}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource EditorPairSwap}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>

                    <!-- F4 + E4：规则参数的即时提示（明文含非法字符、序号步长为 0）。
                         原先这类问题只在底部预览行汇总，用户知道「某行有问题」却不知道该改哪个输入框；
                         这里紧贴编辑区给出原因，并在提示首次出现时抖一下。 -->
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding Config.InputWarning}"
                               local:Shake.On="{Binding Config.InputWarning}"
                               Visibility="{Binding Config.InputWarning, Converter={StaticResource NotEmptyVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- 自绘边框：无系统窗口边框时，用一圈细边框划出窗口边界；圆角由 DWM 负责裁切
         最大化时由代码将边框厚度置 0，使标题栏按钮识别区能真正贴到屏幕边缘 -->
    <Border x:Name="WindowFrame"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusL}"
            Background="{DynamicResource WindowBrush}">
    <!-- 这层 Grid 自带与窗口一致的底色：主题波纹要把本层截成位图当“旧主题快照”，
         若此处留空，快照在无子元素覆盖的区域会是透明的，波纹经过时会提前露出新底色。 -->
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!-- ══════════════ 顶部标题栏（自绘） ══════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource WindowBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource AccentBrush}">
                        <Path Style="{StaticResource IconPathWhite}" Width="16" Height="16"
                              Data="{StaticResource Icon.PenLine}" />
                    </Border>
                    <TextBlock Text="批量文件重命名" FontSize="{StaticResource FontSizeHeadingHalf}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="9,0,0,0" Foreground="{DynamicResource TextBrush}" />
                    <!-- 关于：程序信息 / 快捷键 / 存储说明 -->
                    <Button Style="{StaticResource TitleIconButton}" Click="AboutButton_Click"
                            Margin="8,0,0,0" ToolTip="关于本程序">
                        <Path Style="{StaticResource IconPathMuted}" Width="17" Height="17"
                              Data="{StaticResource Icon.Info}" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 外观切换：滑块三档（左 明 / 中 暗 / 右 跟随系统），图标内嵌于滑块 -->
                    <Slider x:Name="ThemeSlider" Style="{StaticResource ThemeSlider}"
                            ValueChanged="ThemeSlider_ValueChanged"
                            VerticalAlignment="Center" Margin="0,0,6,0"
                            ToolTip="外观：左 明 / 中 暗 / 右 跟随系统" />
                    <Border Style="{StaticResource ToolSep}" Height="16" Margin="10,0" />
                    <Button Style="{StaticResource WindowMinButton}" Click="WindowMin_Click" ToolTip="最小化">
                        <Path Style="{StaticResource WindowGlyph}" Data="{StaticResource Icon.WindowMin}" />
                    </Button>
                    <Button Style="{StaticResource WindowMaxButton}" Click="WindowMax_Click" ToolTip="最大化 / 还原">
                        <Path x:Name="MaxIconPath" Style="{StaticResource WindowGlyph}"
                              Data="{StaticResource Icon.WindowMax}" />
                    </Button>
                    <!-- 关闭按钮：识别区向右侧延伸 16px 直抵窗口右边缘（视觉色块位置不变），
                         便于鼠标“贴右上角”直接命中 -->
                    <Button Style="{StaticResource WindowCloseButton}" Click="WindowClose_Click" ToolTip="关闭"
                            Width="50" Margin="2,0,-16,0">
                        <Path Style="{StaticResource WindowGlyph}" Data="{StaticResource Icon.X}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ 主内容区 ══════════════ -->
        <!-- 三栏最小宽度按实测布局写死为 380 / 516 / 442：
             三者之和 1338 ≈ 窗口最小宽 1384 − 左右外边距 32 − 两条分隔条 12，
             即窗口缩到最小时三栏刚好各自落到自己的最小宽度，比例不会互相挤扁。 -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" Margin="16,10,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" MinWidth="380" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1.1*" MinWidth="516" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1*" MinWidth="442" />
            </Grid.ColumnDefinitions>

            <!-- ───────── 左：文件列表 ───────── -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXl}" Padding="12">
                 <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" MinHeight="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelAccentBar}" />
                        <TextBlock Grid.Column="1" Text="文件列表" Style="{StaticResource PanelHeader}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                   Text="{Binding SelectedText, StringFormat=已选 {0}}" />
                    </Grid>

                    <!-- 列表工具栏：按「导入 / 选择与移除」两行分组，行段之间留白，避免拥挤 -->
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <WrapPanel>
                            <Button Style="{StaticResource ToolAccentButton}"
                                    Command="{Binding ImportFilesCommand}" ToolTip="导入文件（Ctrl+O）">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ToolIconPath}" Data="{StaticResource Icon.FilePlus}" />
                                    <TextBlock Text="导入文件" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolAccentButton}"
                                    Command="{Binding ImportFolderCommand}" ToolTip="导入文件夹（Ctrl+Shift+O）">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ToolIconPath}" Data="{StaticResource Icon.FolderPlus}" />
                                    <TextBlock Text="导入文件夹" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ListToolButton}"
                                    Command="{Binding RefreshCommand}" ToolTip="重新扫描已导入的文件（F5）">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ToolIconPath}" Data="{StaticResource Icon.RotateCw}" />
                                    <TextBlock Text="刷新" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <!-- 全勾选 / 全不选合并为一个按钮：没有勾选任何文件时显示「全勾选」，
                                 已有勾选（部分或全部）时显示「全不选」；两态互斥，任一时刻只出现一个。 -->
                            <Button Style="{StaticResource ToolSuccessButton}"
                                    Command="{Binding SelectAllCommand}" ToolTip="勾选全部文件（Ctrl+A）"
                                    Visibility="{Binding AnyFileSelected, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ToolIconPath}" Data="{StaticResource Icon.CheckSquare}" />
                                    <TextBlock Text="全勾选" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ListToolButton}"
                                    Command="{Binding SelectNoneCommand}" ToolTip="取消全部勾选（Ctrl+Shift+A）"
                                    Visibility="{Binding AnyFileSelected, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ToolIconPath}" Data="{StaticResource Icon.Square}" />
                                    <TextBlock Text="全不选" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolDangerButton}"
                                    Command="{Binding DeleteSelectedCommand}" Click="DeleteSelected_Click"
                                    ToolTip="从列表移除所勾选的文件（Delete）">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ToolIconPath}" Data="{StaticResource Icon.Trash2}" />
                                    <TextBlock Text="移除所选" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolDangerButton}"
                                    Command="{Binding ClearCommand}" Click="ClearMissing_Click"
                                    ToolTip="清除列表中已失效（文件已被移动或删除）的条目"
                                    Visibility="{Binding CanClearMissing, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ToolIconPath}" Data="{StaticResource Icon.Eraser}" />
                                    <TextBlock Text="清除失效" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- 筛选 + 排序（仅作用于本列表） -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <!-- 用 Grid 显式分列：图标左间距 7、右间距 7，使“边框→图标”与“图标→光标”完全相等 -->
                            <Border MinHeight="30"
                                    Background="{DynamicResource InputBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusM}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Style="{StaticResource IconPathFaint}" Width="13" Height="13"
                                          Data="{StaticResource Icon.Search}" Margin="6,0,7,0"
                                          VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBox x:Name="FilterBox" Grid.Column="1" Padding="0,0,6,0" MinHeight="0"
                                             BorderThickness="0" Background="Transparent"
                                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="FilterBox_KeyDown"
                                             ToolTip="根据内容筛选，仅筛选结果参与改名（Ctrl+F 定位到此；回车回到列表，Esc 清空）" />
                                </Grid>
                            </Border>
                        </Grid>
                        <ComboBox Grid.Column="1" Width="112" Margin="8,0,0,0"
                                  ItemsSource="{Binding SortModes}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding SortMode}"
                                  ToolTip="排序方式" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <!-- 虚拟化：ItemsSource 是顶层文件夹，每个文件夹模块自带「表头 + 容器」并把整棵子树
                             一次性渲染出来。因此这里的虚拟化只能按「整个文件夹」为单位回收，多文件夹导入时
                             能少渲染大量看不见的子树；单个超大文件夹（最常见的场景）不受益——它的几千行都
                             在同一个列表项内部。要覆盖该场景需把树拍平成单行列表，代价是文件夹折叠动画从
                             「整块卷起」退化为逐行，故暂不做。
                             ScrollUnit=Pixel：保持像素级平滑滚动（默认按项滚动会让滚动一格跨过整个文件夹）。
                             行动画对容器缺失的场景已有兜底（AnimateFolderRoll / AnimateRowShift 均会跳过）。 -->
                        <ListBox x:Name="FileListBox"
                                 ItemsSource="{Binding RootFolders}"
                                 Background="Transparent" BorderThickness="0"
                                 Focusable="True" IsTabStop="True"
                                 FocusVisualStyle="{x:Null}"
                                 PreviewKeyDown="FileList_PreviewKeyDown"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <!-- 勾选由行内复选框承担。容器自身不取焦点（否则点击一行会给整个文件夹块套上焦点框），
                                     键盘导航交由 FileListBox 的 PreviewKeyDown 统一处理，焦点落在当前行的复选框上。 -->
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Padding" Value="2,0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border CornerRadius="{StaticResource RadiusS}" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- 空状态 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,24"
                                    Visibility="Collapsed" Opacity="0"
                                    local:FadeVisibility.Visible="{Binding HasFiles, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <Border Width="46" Height="46" CornerRadius="23" HorizontalAlignment="Center"
                                    Background="{DynamicResource SurfaceAltBrush}">
                                <Path Style="{StaticResource IconPathFaint}" Width="22" Height="22"
                                      Data="{StaticResource Icon.FilePlus}" />
                            </Border>
                            <TextBlock Text="尚未导入文件" FontSize="{StaticResource FontSizeSubtitle}" Margin="0,10,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="点击上方「导入文件 / 导入文件夹」，或将文件 / 文件夹拖入窗口" FontSize="{StaticResource FontSizeCaptionHalf}" Margin="0,3,0,0"
                                       Foreground="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="4" Text="{Binding FileTotalText}" Style="{StaticResource HintText}"
                               Margin="0,6,0,0" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource VSplitter}" />

            <!-- ───────── 中：规则链 ───────── -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXl}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" MinHeight="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelAccentBar}" />
                        <TextBlock Grid.Column="1" Text="重命名规则" Style="{StaticResource PanelHeader}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="RuleTypeCombo" Width="144"
                                      ItemsSource="{x:Static m:EnumUi.RuleTypes}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value" />
                            <Button Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"
                                    Click="AddRuleButton_Click" ToolTip="把所选规则加入下方规则链">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPathWhite}" Width="14" Height="14" Data="{StaticResource Icon.Plus}" />
                                    <TextBlock Text="添加" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 规则链管理：全启用 / 全停用合并为一个按钮（无启用项 → 全启用；已有启用项 → 全停用） -->
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <Button Style="{StaticResource ToolSuccessButton}"
                                Command="{Binding EnableAllRulesCommand}"
                                ToolTip="启用规则链中的全部规则"
                                Visibility="{Binding AnyRuleEnabled, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ToolIconPath}" Data="{StaticResource Icon.CheckSquare}" />
                                <TextBlock Text="全启用" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ListToolButton}"
                                Command="{Binding DisableAllRulesCommand}"
                                ToolTip="停用规则链中的全部规则"
                                Visibility="{Binding AnyRuleEnabled, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ToolIconPath}" Data="{StaticResource Icon.Square}" />
                                <TextBlock Text="全停用" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolAccentButton}" Click="PresetButton_Click"
                                ToolTip="保存 / 载入规则预设">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ToolIconPath}" Data="{StaticResource Icon.LayoutTemplate}" />
                                <TextBlock Text="预设" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolDangerButton}" Click="ClearAllRules_Click"
                                ToolTip="清空规则链中的全部规则">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource ToolIconPath}" Data="{StaticResource Icon.Trash2}" />
                                <TextBlock Text="清空" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- 规则卡片滚动列表：始终预留滚动条槽位，避免出现/消失时内容宽度抖动 -->
                    <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="RuleItemsHost" ItemsSource="{Binding Rules}"
                                      ItemTemplate="{StaticResource RuleCardTemplate}" />
                    </ScrollViewer>

                    <!-- 空状态 -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="0,0,0,24" Visibility="Collapsed" Opacity="0"
                                local:FadeVisibility.Visible="{Binding HasRules, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <Border Width="46" Height="46" CornerRadius="23" HorizontalAlignment="Center"
                                Background="{DynamicResource SurfaceAltBrush}">
                            <Path Style="{StaticResource IconPathFaint}" Width="22" Height="22"
                                  Data="{StaticResource Icon.PenLine}" />
                        </Border>
                        <TextBlock Text="尚未添加规则" FontSize="{StaticResource FontSizeSubtitle}" Margin="0,10,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="从右上角选择规则类型并点击「＋ 添加」" FontSize="{StaticResource FontSizeCaptionHalf}" Margin="0,3,0,0"
                                   Foreground="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Style="{StaticResource VSplitter}" />

            <!-- ───────── 右：预览 ───────── -->
            <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusXl}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.3*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" MinHeight="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelAccentBar}" />
                        <TextBlock Grid.Column="1" Text="预览" Style="{StaticResource PanelHeader}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HintText}">
                                <Run Text="改名 " /><Run Text="{Binding OkChangeCount, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource ConflictStat}" Margin="10,0,0,0">
                                <Run Text="冲突 " /><Run Text="{Binding Conflicts, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- 预览过滤 -->
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="显示" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox Width="110" ItemsSource="{Binding PreviewFilters}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding PreviewFilter}" />
                            <TextBlock Text="冲突策略" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="14,0,6,0" />
                            <ComboBox Width="130" ItemsSource="{Binding ConflictPolicies}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Policy}"
                                      ToolTip="执行前体检发现重名时的处理方式" />
                        </StackPanel>
                        <!-- 预览列表的表头说明：单独一行，紧贴列表上方 -->
                        <TextBlock Text="旧文件名 → 新文件名" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- 预览行 -->
                    <ListBox x:Name="PreviewListBox" Grid.Row="2" Margin="0,8,0,0" ItemsSource="{Binding Previews}"
                             ItemTemplate="{StaticResource PreviewRowTemplate}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="2,0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 空状态 -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed" Opacity="0"
                                local:FadeVisibility.Visible="{Binding HasPreviews, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <Border Width="46" Height="46" CornerRadius="23" HorizontalAlignment="Center"
                                Background="{DynamicResource SurfaceAltBrush}">
                            <Path Style="{StaticResource IconPathFaint}" Width="22" Height="22"
                                  Data="{StaticResource Icon.ListOrdered}" />
                        </Border>
                        <TextBlock Text="暂无预览" FontSize="{StaticResource FontSizeSubtitle}" Margin="0,10,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="导入文件并添加规则后，这里逐行显示「旧文件名 → 新文件名」" FontSize="{StaticResource FontSizeCaptionHalf}" Margin="0,3,0,0"
                                   Foreground="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="3" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10" />

                    <!-- 日志标题 -->
                    <Grid Grid.Row="4" MinHeight="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelAccentBar}" />
                        <TextBlock Grid.Column="1" Text="执行日志" Style="{StaticResource PanelHeader}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="仅重试失败项" Height="26" MinHeight="0" Padding="10,0" Margin="0,0,8,0"
                                    FontSize="{StaticResource FontSizeBody}" Command="{Binding RetryFailedCommand}"
                                    Visibility="{Binding CanRetryFailed, Converter={StaticResource BoolVis}}"
                                    ToolTip="只勾选本次执行失败的文件，并再次执行改名" />
                            <Button Content="清空日志" Height="26" MinHeight="0" Padding="10,0"
                                    FontSize="{StaticResource FontSizeBody}" Style="{StaticResource DangerButton}"
                                    Click="ClearLogButton_Click"
                                    ToolTip="清空本次执行日志" />
                        </StackPanel>
                    </Grid>

                    <!-- 日志列表 -->
                    <ListBox x:Name="LogListBox" Grid.Row="5" Margin="0,6,0,0" ItemsSource="{Binding Logs}"
                             ItemTemplate="{StaticResource LogRowTemplate}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Visible">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="2,0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 空状态 -->
                    <StackPanel Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="Collapsed" Opacity="0"
                                local:FadeVisibility.Visible="{Binding HasLogs, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <Border Width="46" Height="46" CornerRadius="23" HorizontalAlignment="Center"
                                Background="{DynamicResource SurfaceAltBrush}">
                            <Path Style="{StaticResource IconPathFaint}" Width="22" Height="22"
                                  Data="{StaticResource Icon.Info}" />
                        </Border>
                        <TextBlock Text="暂无执行日志" FontSize="{StaticResource FontSizeSubtitle}" Margin="0,10,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="点击「开始重命名」后，这里按文件显示处理结果" FontSize="{StaticResource FontSizeCaptionHalf}" Margin="0,3,0,0"
                                   Foreground="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ 底部状态栏 ══════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左：文件统计 -->
                <TextBlock Grid.Column="0" Style="{StaticResource MutedText}" FontSize="{StaticResource FontSizeBody}"
                           VerticalAlignment="Center">
                    <Run Text="{Binding FileTotalText, Mode=OneWay}" /><Run Text="　·　已选 " /><Run Text="{Binding SelectedText, Mode=OneWay}" />
                </TextBlock>

                <!-- 中：任务摘要（空闲时） / 执行进度（执行中） -->
                <Grid Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MutedText}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding TaskSummary, Mode=OneWay}"
                               Visibility="{Binding HasProgress, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasProgress, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding ProgressText, Mode=OneWay}" Style="{StaticResource MutedText}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" />
                        <ProgressBar Width="240" Margin="10,0"
                                     Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                     VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center">
                            <Run Text="{Binding ProgressPercent, Mode=OneWay}" /><Run Text="%" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- 右：撤销 / 重做 / 主操作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="HistoryButton_Click" Margin="0,0,10,0"
                            ToolTip="查看历史改名批次，可整体回滚">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Icon.ListOrdered}" />
                            <TextBlock Text="历史记录" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding UndoCommand}" Margin="0,0,8,0"
                            ToolTip="撤销最近一次改名批次（Ctrl+Z）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Icon.RotateCcw}" />
                            <TextBlock Text="撤销" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RedoCommand}" Margin="0,0,12,0"
                            ToolTip="重做被撤销的改名批次（Ctrl+Y）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Width="15" Height="15" Data="{StaticResource Icon.RotateCw}" />
                            <TextBlock Text="重做" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding ExecuteCommand}"
                            ToolTip="{Binding ExecuteTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathWhite}" Width="15" Height="15" Data="{StaticResource Icon.Play}" />
                            <TextBlock Text="开始重命名" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ 通知浮层（执行结果等非阻塞反馈） ══════════════ -->
        <!-- 右下角、状态栏上方：多条通知可同时存在，逐条自窗口右侧滑入、到期或点击后向右滑出。
             某条出现 / 消失后，其余条目由代码后置播放「上举 / 下落」补偿动画（见 MainWindow.xaml.cs）。
             三种类型：成功（绿 2s）/ 警告（黄 3s，文件名冲突）/ 报错（红 5s，占用 / 不存在等）。 -->
        <ItemsControl x:Name="ToastHost" Grid.Row="1" Panel.ZIndex="10001"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18"
                      IsTabStop="False" ItemsSource="{Binding Toasts}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- 卡片根部用 Grid 而非 Border 来承载投影：Grid 内部只画出圆角卡片，
                         四角之外是透明的，因此投影天然呈圆角；若把 Effect 加在设置了
                         ClipToBounds 的元素上，阴影会被矩形剪裁成带直角的黑色方块。 -->
                    <Grid x:Name="ToastCard" Width="420" Margin="0,0,0,12"
                          RenderTransformOrigin="0.5,0.5" Loaded="ToastCard_Loaded">
                        <!-- 投影取自主题令牌（Colors*.xaml 的 ShadowEffect）：深色主题下加深、
                             高对比度主题下直接关闭投影，不再各处硬编码同一组参数。 -->
                        <Grid.Effect>
                            <StaticResource ResourceKey="ShadowEffect" />
                        </Grid.Effect>
                        <!-- 底色统一使用常规背景色，只有左侧竖条与图标圆底随通知类型着色 -->
                        <Border x:Name="ToastSurface" CornerRadius="{StaticResource Radius2Xl}" Padding="18,16"
                                Cursor="Hand" ToolTip="点击关闭（按 Esc 可关闭全部通知）"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding DismissCommand}" />
                            </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧强调竖条：随提示类型变色 -->
                            <Border Grid.Column="0" Width="5" Margin="0,0,16,0" CornerRadius="2.5"
                                    VerticalAlignment="Stretch">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ToastIsWarning}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- 图标：实色圆底 + 白色描边，随类型变色换图标 -->
                            <Border Grid.Column="1" Width="46" Height="46" CornerRadius="23"
                                    Margin="0,0,15,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ToastIsWarning}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Path Width="26" Height="26" Stretch="Uniform" Stroke="White" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource Icon.Check}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ToastIsWarning}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource Icon.AlertTriangle}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource Icon.X}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ToastTitle}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeHeading}"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,5,0,0"
                                           FontSize="{StaticResource FontSizeSubtitleHalf}" LineHeight="21"
                                           Foreground="{DynamicResource MutedTextBrush}" MaxWidth="620" />
                            </StackPanel>
                        </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ══════════════ 拖拽导入遮罩 ══════════════ -->
        <!-- 从资源管理器拖入文件 / 文件夹时覆盖整个内容区，明确告知“可以松手了”。
             仅改光标时代价太低：窗口这么大，用户不知道鼠标底下能不能接住。
             ZIndex 低于 DragLayer(10000)，内部拖拽浮层仍显示在其上。 -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="3" Panel.ZIndex="9000"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Border Background="{DynamicResource AccentSoftBrush}" Opacity="0.95" />
            <Rectangle Margin="26" RadiusX="10" RadiusY="10" StrokeThickness="2"
                       Stroke="{DynamicResource AccentBrush}" StrokeDashArray="5 4" Opacity="0.7" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}">
                    <Path Style="{StaticResource IconPathAccent}" Width="28" Height="28"
                          Data="{StaticResource Icon.FilePlus}" />
                </Border>
                <TextBlock Text="松开鼠标即导入" FontSize="{StaticResource FontSizeHeading}" FontWeight="SemiBold" Margin="0,14,0,0"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="支持文件与文件夹；文件夹会递归导入其中的全部文件" FontSize="{StaticResource FontSizeBody}" Margin="0,6,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ══════════════ 拖拽浮层 ══════════════ -->
        <!-- 拖拽时在此显示被拖元素的“投影”，确保浮于文件列表 / 规则区 / 预览区等所有区域之上 -->
        <Canvas x:Name="DragLayer" Grid.RowSpan="3" Panel.ZIndex="10000" IsHitTestVisible="False" />

        <!-- ══════════════ 模态遮罩层（E3） ══════════════ -->
        <!-- 模态窗口（提示框 / 预设 / 历史 / 关于）打开时把主窗内容压暗一层，
             让「此刻只能操作弹窗」一眼可见。层常驻、只动 Opacity：
             与主题波纹同理，切 Visibility 会触发整窗重新布局，那一帧正好与弹窗首帧叠在一起。
             透明度由代码淡入淡出（见 PushModalScrim / PopModalScrim）。 -->
        <Border x:Name="ModalScrim" Grid.RowSpan="3" Panel.ZIndex="9998"
                Background="#000000" Opacity="0" IsHitTestVisible="False" />

        <!-- ══════════════ 主题切换波纹层 ══════════════ -->
        <!-- 换色时以外观滑块中心为圆心向外扩散一个“圆形揭示区”：
             半径之外盖着换色前的整窗快照（旧主题），半径之内遮罩透明、露出已换色的实时界面（新主题），
             于是整窗颜色随圆圈推进“经过的区域才变色”，尚未到达的区域仍是旧主题。
             本层常年 Visible（图源为空时什么都不画），绝不在代码里改 Visibility：
             Hidden/Visible 切换会触发一次整窗重新布局，与换肤同帧叠加就是一次丢帧，
             观感上正是切换瞬间的轻微抖动。 -->
        <Grid x:Name="ThemeRippleLayer" Grid.RowSpan="3" Panel.ZIndex="9999"
              IsHitTestVisible="False" ClipToBounds="True">
            <Image x:Name="ThemeRippleSnapshot" Stretch="Fill" IsHitTestVisible="False">
                <!-- 遮罩用绝对像素定位到滑块中心：半径内透明（露出新主题），半径外不透明（露出旧主题快照）。
                     注意透明段只到 0.94 —— 真正“完全揭示”的半径是 0.94R，
                     终点的取值必须按此反算，见 PlayThemeRipple 中的说明。 -->
                <Image.OpacityMask>
                    <RadialGradientBrush x:Name="ThemeRippleMask" MappingMode="Absolute"
                                         Center="0,0" GradientOrigin="0,0"
                                         RadiusX="1" RadiusY="1" SpreadMethod="Pad">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="0.94" />
                        <GradientStop Color="#FFFFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Image.OpacityMask>
            </Image>
        </Grid>
    </Grid>
    </Border>
</local:ToolWindow>
