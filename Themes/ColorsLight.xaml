<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题：米白暖底 + 墨绿强调 -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F0E8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FCFBF6" />
    <SolidColorBrush x:Key="CardBrush" Color="#1F2F6B4F" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F3EFE5" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F9F6EF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#C7D3CA" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#93AB9C" />
    <SolidColorBrush x:Key="TextBrush" Color="#232B26" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5E6B62" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#939E95" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6B4F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#245239" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F2F8F4" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E8B57" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E0F0E6" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C4453C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F7E2DF" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B07B1C" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#F5ECD6" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#1C000000" />
</ResourceDictionary>
