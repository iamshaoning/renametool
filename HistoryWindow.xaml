<local:ToolWindow x:Class="RenameTool.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RenameTool"
        Title="改名历史"
        Icon="Assets/app.ico"
        Width="580" Height="560" MinWidth="460" MinHeight="380"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei"
        UseLayoutRounding="True"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="{StaticResource RadiusL}"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:BoolVisibilityConverter x:Key="BoolVis" />

        <!-- 历史批次行：时间 + 状态 + 规则摘要 + 回滚按钮 -->
        <DataTemplate x:Key="HistoryRowTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusL}"
                    Background="{DynamicResource CardBrush}" Margin="0,0,0,8" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TimeText}" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="3" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RolledBack}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FontSizeTinyHalf}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RolledBack}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DetailText}" FontSize="{StaticResource FontSizeBody}" Margin="0,5,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}" />
                    </StackPanel>

                    <Button Grid.Column="1" VerticalAlignment="Center" Height="28" MinHeight="0" Padding="12,0"
                            FontSize="{StaticResource FontSizeBody}" Content="回滚"
                            Command="{Binding DataContext.RollbackHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="把该批次的文件整体改回原名">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RolledBack}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Content" Value="已回滚" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- 自绘边框：与主窗口一致的外圈细边框；圆角由 DWM 负责裁切 -->
    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusL}"
            Background="{DynamicResource WindowBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource WindowBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="改名历史" FontSize="{StaticResource FontSizeTitleHalf}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Grid.Column="1" Style="{StaticResource HintText}" VerticalAlignment="Center"
                           Margin="10,0,0,0" TextWrapping="NoWrap"
                           Text="记录本机每次成功执行的批次，可随时整体回滚" />
                <Button Grid.Column="2" Style="{StaticResource ToolCloseButton}" Click="Close_Click" />
            </Grid>
        </Border>

        <!-- 列表 -->
        <Grid Grid.Row="1" Margin="16,12">
            <ListBox x:Name="HistoryListBox" ItemsSource="{Binding History}" ItemTemplate="{StaticResource HistoryRowTemplate}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" Opacity="0"
                        local:FadeVisibility.Visible="{Binding HasHistory, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                <TextBlock Text="暂无改名历史" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="执行一次重命名后，这里会出现可回滚的批次记录" FontSize="{StaticResource FontSizeCaptionHalf}" Margin="0,4,0,0"
                           Foreground="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 底部操作 -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" HorizontalAlignment="Left" Height="30" MinHeight="0" Padding="12,0"
                        FontSize="{StaticResource FontSizeBody}" Content="清空历史" Style="{StaticResource DangerButton}"
                        Click="ClearHistory_Click"
                        ToolTip="清除全部历史记录" />
                <Button Grid.Column="1" Style="{StaticResource DialogCloseButton}" Click="Close_Click" />
            </Grid>
        </Border>
    </Grid>
    </Border>
</local:ToolWindow>
